# ignore build outputs of contract
contract/*/cache
contract/*/out
contract/*/build
contract/*/b
contract/*/broadcast

# unused leftover vendor tree (OriginalContent does not import OpenZeppelin)
contract/*/lib/openzeppelin-contracts

# ignore npm install trees (do not ship in source archives)
node_modules
**/node_modules

# ignore frontend build output
frontend/dist

# ignore coverage reports
contract/*/coverage.lcov
contract/*/lcov.info

# ignore generated phash-js assets copied into frontend/public
frontend/public/phash.js
frontend/public/magick.js
frontend/public/magick.wasm

# ignore indexer runtime artifacts
indexer/data/index.json
